{
  "version": 3,
  "note": "agent 适配表。exe 为绝对路径或 PATH 命令名；args 里 {prompt}/{cwd}/{port} 会被替换（{port} 每次取空闲端口）。failPattern 命中即判失败。sandboxArgs 声明该 agent 支持的沙箱档位；caps 只用于 -Doctor 展示，不代表实测。",
  "agents": {
    "codex": {
      "label": "Codex",
      "verified": true,
      "exe": "codex.cmd",
      "fallbackExe": [
        "codex"
      ],
      "args": [
        "exec",
        "--skip-git-repo-check",
        "-C",
        "{cwd}",
        "{prompt}"
      ],
      "sandboxArgs": {
        "read-only": [
          "--sandbox",
          "read-only"
        ],
        "workspace-write": [
          "--sandbox",
          "workspace-write"
        ]
      },
      "caps": {
        "headless": true,
        "jsonOut": true,
        "sandbox": true,
        "session": true,
        "timeout": true,
        "worktree": true
      },
      "env": {},
      "failPattern": [],
      "timeoutMin": 20,
      "hint": "复用 codex 已登录的会话，无需 API key（已实测）",
      "defaultSandbox": "read-only"
    },
    "workbuddy": {
      "label": "WorkBuddy",
      "verified": false,
      "exe": "node.exe",
      "args": [
        "D:/workbuddy/resources/app.asar.unpacked/cli/bin/codebuddy",
        "-p",
        "{prompt}",
        "--port",
        "{port}"
      ],
      "caps": {
        "headless": true,
        "jsonOut": true,
        "sandbox": false,
        "session": false,
        "timeout": false,
        "worktree": false
      },
      "env": {
        "CODEBUDDY_FORCE_LITE_WB_BUNDLE": "1"
      },
      "failPattern": [
        "Authentication required",
        "not signed in",
        "/login",
        "Cannot find module",
        "EADDRINUSE",
        "codebuddy-lite-wb"
      ],
      "timeoutMin": 20,
      "hint": "这个发行版 cli/dist 只有 codebuddy-lite-wb.mjs、没有完整版 bundle，默认入口会报 Cannot find module；适配表已注入 CODEBUDDY_FORCE_LITE_WB_BUNDLE=1 强制走 lite-wb，并用 {port} 自动取空闲端口（桌面版常占 55298）。剩下一件事：进一次 TUI 输 /login 完成浏览器授权，和桌面版登录分开；/login 是 TUI 内的斜杠命令，不是命令行参数",
      "fix": "运行 login-agents.ps1 选 1（自动设 env + 空闲端口），进 TUI 后输 /login"
    },
    "zcode": {
      "label": "ZCode",
      "verified": false,
      "exe": "node.exe",
      "args": [
        "D:/zcode/resources/glm/zcode.cjs",
        "-p",
        "{prompt}",
        "--cwd",
        "{cwd}"
      ],
      "caps": {
        "headless": true,
        "jsonOut": false,
        "sandbox": false,
        "session": true,
        "timeout": false,
        "worktree": false
      },
      "env": {},
      "failPattern": [
        "无法定位 CLI ZCode",
        "provider",
        "Select a model"
      ],
      "timeoutMin": 20,
      "hint": "CLI 找 resources/glm/provider/（本机实际在 resources/config/provider/，已补软链）；还缺一次性浏览器授权 + 在 TUI 里选模型。CLI 没有 --model 参数，不选模型时 headless 报 Select a model before sending a message",
      "fix": "运行 login-agents.ps1 选 2（授权后进 TUI 输 /model 选一个模型）"
    },
    "dsh": {
      "label": "DSH (DeepSeek Harness)",
      "verified": false,
      "exe": "D:/DeepSeek Harness.new-{1206E67A-17A8-42B9-8976-92FB26540F91}/resources/runtime/cli/bin/dsh.cmd",
      "args": [
        "headless",
        "{prompt}"
      ],
      "caps": {
        "headless": true,
        "jsonOut": true,
        "sandbox": false,
        "session": true,
        "timeout": false,
        "worktree": false
      },
      "env": {
        "DEEPSEEK_API_KEY": ""
      },
      "failPattern": [
        "MISSING_CREDENTIAL"
      ],
      "timeoutMin": 20,
      "hint": "需要 DEEPSEEK_API_KEY；在该 job 的 env 里给",
      "fix": "在 jobs.json 的 env 里写 DEEPSEEK_API_KEY"
    },
    "echo": {
      "label": "Echo（自检用）",
      "verified": true,
      "exe": "cmd.exe",
      "args": [
        "/c",
        "echo {prompt}"
      ],
      "caps": {
        "headless": true,
        "jsonOut": false,
        "sandbox": false,
        "session": false,
        "timeout": true,
        "worktree": false
      },
      "env": {},
      "failPattern": [],
      "timeoutMin": 1,
      "hint": "不调用任何模型，用来验证调度/去重/日志"
    }
  }
}
